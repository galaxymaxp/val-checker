{
  "manifest_version": 3,
  "name": "VAL Checker Riot Connect",
  "description": "Connects a Riot session to VAL Checker after you sign in on Riot's real website.",
  "version": "1.2.0",
  "permissions": ["alarms", "cookies", "storage"],
  "host_permissions": [
    "https://auth.riotgames.com/*",
    "https://*.riotgames.com/*",
    "https://playvalorant.com/*",
    "https://val-checker-three.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://val-checker-three.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://playvalorant.com/*"],
      "js": ["riot-callback.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "VAL Checker Riot Connect"
  }
}
