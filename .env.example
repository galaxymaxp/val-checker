# Browser-safe Supabase configuration. Prefer the publishable key; the legacy
# anon key remains supported as an alternative.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase elevation. Prefer the secret key; the legacy service-role
# key remains supported as an alternative. Never use either in NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AES-256-GCM keyring. Each versioned key is base64 for exactly 32
# random bytes. Retain every version still referenced by stored ciphertext.
SESSION_ENCRYPTION_CURRENT_VERSION=
SESSION_ENCRYPTION_KEY_V1=

# Server-only, fail-closed Riot connection allowlist. Values are comma-separated.
RIOT_CONNECT_ALLOWED_USER_IDS=
RIOT_CONNECT_ALLOWED_EMAILS=

# Server-only administrator list, comma-separated emails. Administrators
# additionally see the raw cookie-export connect path, kept as a fallback for
# when Riot's sign-in endpoint refuses server requests. Ordinary allowlisted
# users sign in with a username and password instead. Fail-closed: empty
# grants nobody. Email-only, since a Supabase user UUID isn't something an
# operator has on hand.

# Optional. Overrides the TLS cipher order used for Riot's auth host, which is
# fingerprinted by Cloudflare. Leave empty unless sign-in starts returning 403.
RIOT_TLS_CIPHERS=

# Server-only email and scheduled-worker configuration.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
