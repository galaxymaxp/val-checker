{
  "name": "valorant-store-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "auth:verify": "node scripts/verify-magic-link.mjs",
    "start": "next start",
    "sync:catalog": "node --experimental-strip-types scripts/sync-catalog.ts",
    "lint": "eslint .",
    "supabase:start": "node scripts/supabase-start.mjs",
    "supabase:stop": "supabase stop",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "30.0.1",
    "supabase": "2.114.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
